SOLANA_NODE_RPC_ENDPOINT=...
SOLANA_NODE_WSS_ENDPOINT=...

GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
GEYSER_AUTH_TYPE=x-token or basic

SOLANA_PRIVATE_KEY=

# --- Dashboard (python -m dashboard, http://127.0.0.1:8787) ---
# The associated wallet is the one derived from SOLANA_PRIVATE_KEY above:
# the SAME wallet the bot trades with. The dashboard shows its address and
# balance in the Wallet panel. Deposit = send SOL to that address.
#
# Set to true to ENABLE real SOL withdrawals from the dashboard. Off by
# default. Only ever accepts requests from localhost (127.0.0.1).
DASHBOARD_ALLOW_WITHDRAW=false
# DASHBOARD_PORT=8787
#
# Remote access (e.g. from your phone over Tailscale):
#   DASHBOARD_HOST=0.0.0.0  -> bind on the LAN/VPN address (default 127.0.0.1)
# Login for remote control (localhost never needs it). Withdraw + wallet
# import stay PC-only regardless. Leave unset to disable remote control.
# DASHBOARD_HOST=127.0.0.1
DASHBOARD_USER=
DASHBOARD_PASSWORD=